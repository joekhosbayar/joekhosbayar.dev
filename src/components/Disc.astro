---
/**
 * The record. Etched grooves, a pulsar map on the label, and one peach ray —
 * the playhead. Everything is stroke; nothing is filled but the void and the
 * spindle. The disc persists after the cover so the whole stays visible while
 * the reader is deep in one detail.
 */
interface Props {
  size?: string;
  idPrefix?: string;
  /** At badge size the fine grooves collapse into mud and the playhead — the
   *  only part that carries information — disappears. Compact drops the groove
   *  field and thickens the ray so the indicator survives. */
  compact?: boolean;
}
const { size = '100%', idPrefix = 'disc', compact = false } = Astro.props;

// Playing surface. Spacing is wide enough that each groove reads as a cut line
// rather than collapsing into a texture — at display size, 3px apart is mud.
const grooves: { r: number; o: number }[] = [];
for (let r = 114; r <= 272; r += 7.4) {
  const band = Math.sin(r / 19);
  grooves.push({ r, o: 0.16 + Math.abs(band) * 0.24 });
}
// Band separators: the record is cut in passages, like the sides it holds.
const bands = [138, 186, 234];

// Pulsar map: 14 rays from the origin, each with binary period ticks.
const rays = [
  { a: -90, len: 168, ticks: 7 },
  { a: -58, len: 132, ticks: 5 },
  { a: -31, len: 178, ticks: 8 },
  { a: -12, len: 104, ticks: 4 },
  { a: 14, len: 152, ticks: 6 },
  { a: 37, len: 118, ticks: 5 },
  { a: 62, len: 166, ticks: 7 },
  { a: 88, len: 126, ticks: 4 },
  { a: 116, len: 172, ticks: 8 },
  { a: 139, len: 110, ticks: 3 },
  { a: 163, len: 158, ticks: 6 },
  { a: -166, len: 122, ticks: 5 },
  { a: -140, len: 148, ticks: 6 },
  { a: -114, len: 100, ticks: 4 },
];
const rad = (d: number) => (d * Math.PI) / 180;
const CX = 300;
const CY = 300;
---

<svg
  class="disc"
  viewBox="0 0 600 600"
  width={size}
  height={size}
  role="img"
  aria-label="An engraved record: concentric grooves around a pulsar map, with one lit ray marking the playhead."
  fill="none"
>
  <!-- The disc is a physical object: it occludes what is behind it. -->
  <circle cx={CX} cy={CY} r="288" fill="var(--void)" />

  <!-- Rim -->
  <circle cx={CX} cy={CY} r="288" stroke="var(--etch-strong)" stroke-width={compact ? 8 : 1} />
  {
    !compact && (
      <Fragment>
        <circle cx={CX} cy={CY} r="281" stroke="var(--etch)" stroke-width="1" />
        <circle cx={CX} cy={CY} r="276" stroke="var(--etch-ghost)" stroke-width="1" />
      </Fragment>
    )
  }

  <!-- Playing surface -->
  <g class="disc-spin" style="transform-origin:300px 300px">
    {
      !compact &&
      grooves.map((g) => (
        <circle
          cx={CX}
          cy={CY}
          r={g.r}
          stroke="var(--gold)"
          stroke-opacity={g.o}
          stroke-width="0.9"
        />
      ))
    }
    {
      bands.map((r) => (
        <circle
          cx={CX}
          cy={CY}
          r={r}
          stroke="var(--gold)"
          stroke-opacity={compact ? 0.42 : 0.5}
          stroke-width={compact ? 7 : 1.1}
        />
      ))
    }
  </g>

  <!-- Label field -->
  {
    !compact && (
      <Fragment>
        <circle cx={CX} cy={CY} r="106" stroke="var(--etch)" stroke-width="1" />
        <circle cx={CX} cy={CY} r="100" stroke="var(--etch-ghost)" stroke-width="1" />
      </Fragment>
    )
  }

  <!-- Pulsar map -->
  <g>
    {
      !compact &&
      rays.map((ray, i) => {
        const x2 = CX + Math.cos(rad(ray.a)) * ray.len;
        const y2 = CY + Math.sin(rad(ray.a)) * ray.len;
        const px = -Math.sin(rad(ray.a));
        const py = Math.cos(rad(ray.a));
        return (
          <g stroke-opacity={0.44}>
            <line
              x1={CX}
              y1={CY}
              x2={x2}
              y2={y2}
              stroke="var(--gold)"
              stroke-width="0.9"
            />
            {Array.from({ length: ray.ticks }).map((_, t) => {
              const d = 34 + ((ray.len - 40) / ray.ticks) * t;
              const bx = CX + Math.cos(rad(ray.a)) * d;
              const by = CY + Math.sin(rad(ray.a)) * d;
              const half = t % 2 === 0 ? 5 : 2.6;
              return (
                <line
                  x1={bx - px * half}
                  y1={by - py * half}
                  x2={bx + px * half}
                  y2={by + py * half}
                  stroke="var(--gold)"
                  stroke-width="1.1"
                  stroke-opacity={0.62}
                />
              );
            })}
          </g>
        );
      })
    }
  </g>

  <!-- The playhead: the one warm mark on the record -->
  <g class="playhead" style="transform-origin:300px 300px">
    <line
      x1={CX}
      y1={CY}
      x2={CX}
      y2={CY - 274}
      stroke="var(--peach)"
      stroke-width={compact ? 16 : 1.3}
      stroke-opacity="0.9"
    />
    <circle cx={CX} cy={CY - 274} r={compact ? 22 : 4} fill="var(--peach)" />
  </g>

  <!-- Spindle -->
  <circle cx={CX} cy={CY} r={compact ? 30 : 13} fill="var(--void)" />
  <circle
    cx={CX}
    cy={CY}
    r={compact ? 30 : 13}
    stroke="var(--etch-strong)"
    stroke-width={compact ? 6 : 1}
  />
  <circle cx={CX} cy={CY} r={compact ? 12 : 3.2} fill="var(--peach)" />
</svg>

<style>
  .disc {
    display: block;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }
  .disc-spin {
    animation: revolve 240s linear infinite;
  }
  .playhead {
    transform: rotate(var(--playhead, 0deg));
    transition: transform 1.6s var(--ease);
  }
  @keyframes revolve {
    to {
      transform: rotate(360deg);
    }
  }
</style>
